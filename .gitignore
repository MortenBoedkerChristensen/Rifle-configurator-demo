# =============================================================================
# .gitignore for the hunter-configurator repo
#
# hunter-configurator/ is a zero-dependency static site, so every file there is
# committed. web/ is a Next.js sketch: source is committed, build output and
# dependencies are not. The rules below cover both.
# =============================================================================

# --- OS junk ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editors / IDEs --------------------------------------------------------
# Uncomment the negations if you want to share workspace settings with the team.
.vscode/
.idea/
*.suo
*.user
*.swp
*~

# --- Secrets & local config ------------------------------------------------
# Turn on the moment you add a backend or any API keys.
.env
.env.*
!.env.example
*.local

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Tooling and generated artifacts
# =============================================================================

# --- Node / bundler --------------------------------------------------------
# The Next.js sketch in web/ needs these ignored once you run npm install.
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# --- Python backend (if you add FastAPI/Flask) -----------------------------
# __pycache__/
# *.py[cod]
# .venv/
# venv/
# .pytest_cache/
# .mypy_cache/
# .ruff_cache/

# --- Local databases (dev only — never commit real data) -------------------
# *.sqlite
# *.sqlite3
# *.db
# pgdata/
# *.dump

# --- Data exports / large binaries you don't want in git -------------------
# *.zip
# exports/
# tmp/
